<h1>Formular Generator</h1>

<table class="table table-bordered">

    <tr>
        <th>Tabelle</th>
        <th>Aktion</th>
    </tr>

    {% for table in tables %}

        <tr>

            <td>{{ table }}</td>

            <td>

              <form method="post">

                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">

                    <input type="hidden" name="form_id" value="generator_create_form">

                    <input type="hidden" name="table" value="{{ table }}">

                    {% if block.buttons is defined and block.buttons is iterable and block.buttons|length > 0 %}
                        <div class="form-actions">
                            {% for button in block.buttons %}
                                <button
                                    type="{{ button.button_type }}"
                                    class="btn btn-{{ button.variant }}"
                                    {% if button.button_action %}name="button_action" value="{{ button.button_action }}"{% endif %}
                                    {% if button.confirm_required %}data-confirm="1"{% endif %}
                                >
                                    {{ t(button.label_key) }}
                                </button>
                            {% endfor %}
                        </div>
                    {% endif %}

                </form>

            </td>

        </tr>

    {% endfor %}

</table>
