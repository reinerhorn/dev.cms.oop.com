{% if t is not defined %}
    {% macro t(key) %}{{ key }}{% endmacro %}
    {% import _self as i18n %}
{% endif %}
{% set config      = block.config is iterable ? block.config : {} %}
 

{# kompatibel mit alter + neuer Formularstruktur #}
{% set fields = block.fields ?? config.fields ?? block.form.fields ?? [] %}
{% set form_class = block.form_class ?? config.form_class ?? null %}

{# Bei einer Generator-Bestätigung die ursprünglich eingegebenen Werte anzeigen #}
{% if form_result is defined and form_result.confirmation is defined and form_result.confirmation %}
    {% set pending_post = form_result.pending_post ?? {} %}

    {% for field in fields %}
        {% set field_name = field.name|default('') %}
        {% if pending_post[field_name] is defined %}
            {% set field = field|merge({'value': pending_post[field_name]}) %}
        {% endif %}
    {% endfor %}
{% endif %}

{# Bei einer Generator-Bestätigung die ursprünglich eingegebenen Werte anzeigen #}
{% if form_result is defined and form_result.confirmation is defined and form_result.confirmation %}
    {% set pending_post = form_result.pending_post ?? {} %}

    {% for field in fields %}
        {% set field_name = field.name|default('') %}
        {% if pending_post[field_name] is defined %}
            {% set field = field|merge({'value': pending_post[field_name]}) %}
        {% endif %}
    {% endfor %}
{% endif %}

<div class="admin-form-wrapper">

{# Formular-Feedback (zentral aus CMSAppFrontend) #}
{% if form_result is defined %}
    {% if form_result.message and not (form_result.confirmation is defined and form_result.confirmation) %}
        <div class="form-message {{ form_result.status == 'ok' ? 'form-success' : 'form-error' }}">
            {{ form_result.message }}
        </div>
    {% endif %}

    {% if form_result.errors is defined and form_result.errors is iterable and form_result.errors|length > 0 %}
        <ul class="form-errors">
            {% for error in form_result.errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endif %}

<form
    method="{{ config.method|default('post') }}"
    data-form
    {% if form_class is not empty %}class="{{ form_class }}"{% endif %}
>
   
        <input type="hidden" name="_csrf" value="{{ csrf }}">
    

    {# eindeutige Formular-ID zur Plugin-Isolation #}
    {% if config.form_id is defined %}
        <input type="hidden" name="form_id" value="{{ config.form_id }}">
    {% endif %}

    {% if form_result is defined and form_result.confirmation is defined and form_result.confirmation %}
        <div class="generator-confirmation">
            <input type="hidden" name="action" value="save">

            <div class="form-message form-error">
                {{ form_result.message }}
            </div>

            <div class="generator-confirmation-buttons">
                <button
                    type="submit"
                    name="generator_decision"
                    value="yes"
                    class="btn btn-primary"
                >
                    Ja
                </button>

                <button
                    type="submit"
                    name="generator_decision"
                    value="no"
                    class="btn btn-secondary"
                >
                    Nein
                </button>
            </div>
        </div>
    {% endif %}

    {% if block.headline %}
        <h1>{{ block.headline }}</h1>
    {% endif %}

    {% if block.text %}
        <div data-form-text>
            {{ block.text|raw }}
        </div>
    {% endif %}


    {% for field in fields %}

        {% set ui = field.ui ?? {} %}
        {% set db = field.db ?? {} %}

        {# kompatibel alt + neu #}
        {% set type = field.type ?? ui.type|default('text') %}
        {% set required = field.required ?? db.required|default(false) %}

        {% set field_name = field.name|default('') %}
        {% set field_id = field.id ?? ui.id|default(field_name) %}

        {# Generator-/POST-Werte haben Vorrang #}
        {% set current_value =
            field_name in form_values|keys
                ? form_values[field_name]
                : (field.value|default(''))
        %}

        {% set field_label = field.label is iterable
            ? (field.label.text|default(field_name))
            : (field.label|default(field_name)) %}

        {# options kompatibel alt + neu #}
        {% set options = field.options ?? ui.options ?? [] %}

    {% if type == 'checkbox' %}
        <div class="checkbox-group">
            <input type="hidden" name="{{ field_name }}" value="0">
            <label>
                <input
                    type="checkbox"
                    name="{{ field_name }}"
                    value="1"
                    {% if current_value in [1, '1', true, 'true', 'on'] %}
                        checked
                    {% endif %}
                    {% if required %}required{% endif %}
                >
                {{ field_label }}
            </label>
        </div>

    {% elseif type == 'textarea' %}
            <textarea
                name="{{ field_name }}"
                placeholder="{{ field_label }}"
                {% if required %}required{% endif %}
            >{{ current_value|default('') }}</textarea>

        {% elseif type == 'select' %}
            <div class="form-group">
                <label for="{{ field_id }}">{{ field_label }}</label>

                {# Wert aus Generator-Session oder Feld-Standardwert #}
                {% set current_value = current_value is not null
                    ? (current_value ~ '')
                    : '' %}

                <select
                    id="{{ field_id }}"
                    name="{{ field_name }}"
                    {% if field_name ends with '_load_id' %}
                        data-redirect-on-change="1"
                    {% endif %}
                    {% if required %}required{% endif %}
                >

                    <option value=""
                        {% if current_value == '' %}selected="selected"{% endif %}>
                        -- neu --
                    </option>

                    {% if options is iterable and options|length > 0 %}
                        {% for option in options %}
                            {% set option_value = option.value ~ '' %}
                            <option value="{{ option_value }}"
                                {% if option_value == current_value %}selected="selected"{% endif %}>
                                {{ option.label }}
                            </option>
                        {% endfor %}
                    {% endif %}
                </select>
            </div>

        {% else %}
            <div class="form-group">
                <input
                    type="{{ type }}"
                    id="{{ field_id }}"
                    name="{{ field_name }}"
                    value="{{ current_value|default('') }}"
                    placeholder=" "
                    {% if required %}required{% endif %}
                >
                <label for="{{ field_id }}">{{ field_label }}</label>
            </div>
        {% endif %}
    {% endfor %}
  
    {% if block.buttons is defined and block.buttons is iterable and block.buttons|length > 0 %}
        <div class="form-actions">
            {% for button in block.buttons %}
                <button
                    type="{{ button.button_type }}"
                    class="btn btn-{{ button.variant }}"
                    {% if button.action %}name="action" value="{{ button.action }}"{% endif %}
                 
                    {% if button.confirm_required %}data-confirm="1"{% endif %}
                >
                    {{ button.label_key }}
                </button>
            {% endfor %}
        </div>
    {% endif %}
</form>
</div>