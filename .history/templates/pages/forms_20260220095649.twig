{% set config      = block.config is iterable ? block.config : {} %}
{% set fields      = config.fields ?? [] %}
{% set form_class  = block.form_class ?? config.form_class ?? null %}

{% if block.wrapper_class is not empty %}
<div class="{{ block.wrapper_class }}">
{% endif %}
<pre>{{ dump(fields) }}</pre>
{# Formular-Feedback (zentral aus CMSAppFrontend) #}
{% if form_result is defined %}
    {% if form_result.message %}
        <div class="form-message {{ form_result.status == 'ok' ? 'form-success' : 'form-error' }}">
            {{ form_result.message }}
        </div>
    {% endif %}

    {% if form_result.errors is defined and form_result.errors is iterable and form_result.errors|length > 0 %}
        <ul class="form-errors">
            {% for error in form_result.errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endif %}

<form
    method="post" 
     data-form
    {% if form_class is not empty %}class="{{ form_class }}"{% endif %}
>
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    {% if block.headline %}
        <h1>{{ block.headline }}</h1>
    {% endif %}

    {% if block.text %}
        <div data-form-text>
            {{ block.text|raw }}
        </div>
    {% endif %}

    {% for field in fields %}
        {% set type = field.ui.type|default('text') %}
        {% set field_name = field.ui.name|default(field.name|default('')) %}
        {% set field_id   = field.ui.id|default(field_name) %}
        {% set field_label = field.label is iterable 
            ? (field.label.text|default(field_name)) 
            : (field.label|default(field_name)) %}

        {% if type == 'checkbox' %}
        <div class="checkbox-group">
            <label>
                <input
                    type="checkbox"
                    name="{{ field_name }}"
                    {% if field.ui.required %}required{% endif %}
                >
                {{ field_label }}
            </label>
        </div>
        {% elseif type == 'textarea' %}
            <textarea
                name="{{ field_name }}"
                placeholder="{{ field_label }}"
                {% if field.ui.required %}required{% endif %}
            ></textarea>

        {% elseif type == 'select' %}
            <div class="form-group">
                <label for="{{ field_id }}">{{ field_label }}</label>

                <select
                    id="{{ field_id }}"
                    name="{{ field_name }}"
                    {% if field.ui.required %}required{% endif %}
                    {% if field.ui.auto_submit is defined and field.ui.auto_submit %}onchange="this.form.submit()"{% endif %}
                >
                    {% if field.ui.placeholder is defined %}
                        <option value=""
                            {% if field.value is not defined or field.value == '' %}selected{% endif %}>
                            {{ field.ui.placeholder }}
                        </option>
                    {% endif %}

                    {% if field.options is defined and field.options is iterable %}
                        {% for option in field.options %}
                            <option value="{{ option.value }}"
                                {% if field.value is defined and field.value == option.value %}selected{% endif %}>
                                {{ option.label }}
                            </option>
                        {% endfor %}
                    {% endif %}
                </select>
            </div>

        {% else %}
            <div class="form-group">
                <input
                    type="{{ type }}"
                    id="{{ field_id }}"
                    name="{{ field_name }}"
                    placeholder=" "
                    {% if field.ui.required %}required{% endif %}
                >
                <label for="{{ field_id }}">{{ field_label }}</label>
            </div>
        {% endif %}
    {% endfor %}

    {% if block.buttons is defined and block.buttons is iterable and block.buttons|length > 0 %}
        <div class="form-buttons">
            {% for button in block.buttons %}
                <button
                    type="{{ button.button_type }}"
                    class="btn btn-{{ button.variant }}"
                    {% if button.action %}name="action" value="{{ button.action }}"{% endif %}
                    {% if button.confirm_required %}data-confirm="1"{% endif %}
                >
                    {{ t(button.label_key) }}
                </button>
            {% endfor %}
        </div>
    {% endif %}
</form>

{% if block.wrapper_class is defined %}
</div>
{% endif %}