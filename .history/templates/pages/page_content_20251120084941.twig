{% set blocks = data.content_data is defined ? data.content_data : content_data %}

<section class="page-content">
   {% for block in blocks %}

    {# -- PLAIN TEXT -- #}
    {% if block.type is not defined %}
        <article class="content-block">
            {% if block.headline %}
                <h1 class="content-headline">{{ block.headline }}</h1>
            {% endif %}
            {% if block.text %}
                <div class="content-text">{{ block.text|raw }}</div>
            {% endif %}
        </article>
    {% endif %}

    {# -- FORMULAR: login_form, register_form etc. -- #}
    {% if block.type is defined and block.type ends with '_form' %}
        {% include "partials/formular.twig" with {
            headline: block.headline,
            text: block.text,
            config: block.config,
            type: block.type
        } %}
    {% endif %}

{% endfor %}
</section>