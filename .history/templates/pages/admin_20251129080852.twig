{% extends "layout/base.twig" %}

{% block content %}
<section class="admin-area">
{# ============================
   PLAINTEXT BLOCK
   ============================ #}
{% if block is defined and block.type == 'plaintext' %}
    <article class="content-block">

        {% if block.headline %}
            <h1 class="content-headline">{{ block.headline }}</h1>
        {% endif %}

        {% if block.text %}
            <div class="content-text">{{ block.text|raw }}</div>
        {% endif %}

    </article>
{% endif %}

    <h1>Admin Bereich</h1>

    <p>Willkommen im Admin Dashboard!</p>

    <ul class="admin-menu">
        <li><a href="/de/admin/content">Content Editor</a></li>
        <li><a href="/de/admin/users">Benutzerverwaltung</a></li>
        <li><a href="/de/admin/roles">Rollen & Rechte</a></li>
        <li><a href="/de/admin/system">System-Checker</a></li>
    </ul>
</section>
{% endblock %}