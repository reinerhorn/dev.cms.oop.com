{% if contents is defined and contents is not empty %}
    {% if constant('CMS_DEBUG') %}
        <div class="content-debug">
            <h3>🧩 Gefundene Inhalte: {{ contents|length }}</h3>
            <ul>
                {% for label, blocks in contents %}
                    <li>
                        <strong>{{ label }}</strong>
                        {% for block in blocks %}
                            <div class="debug-block">
                                <p><strong>Headline:</strong> {{ block.headline|default('—') }}</p>
                                <p><strong>Text:</strong> {{ block.text|default('—') }}</p>
                                <p><strong>Sprache:</strong> {{ block.lang|default('n/a') }}</p>
                            </div>
                        {% endfor %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% else %}
        {# --- Normale Ausgabe --- #}
        <section class="page-content">
            {% for label, blocks in contents %}
                {% for block in blocks %}
                    {% set has_content = block.headline or block.text %}
                    {% if has_content %}
                        <article class="content-block" id="{{ label|lower }}">
                            {% if block.headline %}
                                <h2>{{ block.headline }}</h2>
                            {% endif %}
                            {% if block.text %}
                                <div class="content-text">
                                    {{ block.text|raw }}
                                </div>
                            {% endif %}
                        </article>
                    {% endif %}
                {% endfor %}
            {% endfor %}
        </section>
    {% endif %}
{% else %}
    <p>⚠️ Kein Inhalt gefunden (Twig-Testausgabe).</p>
{% endif %}