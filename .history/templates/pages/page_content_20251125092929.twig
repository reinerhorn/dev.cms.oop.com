{# pages/page_content.twig — LOGIN + PLAINTEXT kompatibel #}

{% set blocks = data.content_data is defined ? data.content_data : content_data %}

<section class="page-content">

    {% if blocks is empty %}
        <section class="error">
            <h2>Keine Inhalte gefunden</h2>
            <p class="content-text">Diese Seite enthält keine Inhalte oder Plugin-Daten.</p>
        </section>
    {% endif %}

    {% for block in blocks %}
        
        {# ============================
           PLAINTEXT BLOCK
           ============================ #}
        {% if block.type == 'plaintext' %}
            <article class="content-block">

                {% if block.headline %}
                    <h1 class="content-headline">{{ block.headline }}</h1>
                {% endif %}

                {% if block.text %}
                    <div class="content-text">{{ block.text|raw }}</div>
                {% endif %}

            </article>
        {% endif %}

        {# ============================
           FORMULAR BLOCK (forms)
           ============================ #}
        {% if block.type in ['forms', 'login-form', 'formular'] %}

            <div class="login-box">
                <form method="post" class="login-form">
                    <input type="hidden" name="action" value="login">

                    {# Headline über dem Formular #}
                    {% if block.headline %}
                        <h1 class="content-headline">{{ block.headline }}</h1>
                    {% endif %}

                    {% if block.text %}
                        <div class="content-text">{{ block.text|raw }}</div>
                    {% endif %}

                    {# Felder generieren #}
                    {% if block.config and block.config.fields %}
                        {% for field in block.config.fields %}

                            {% set type =
                                field == 'email'    ? 'email' :
                                field == 'password' ? 'password' :
                                field == 'agree'    ? 'checkbox' :
                                'text'
                            %}

                            {% if type == 'checkbox' %}
                                <div class="agb-wrapper">
                                    <input type="checkbox" name="{{ field }}">
                                    <label for="{{ field }}">Ich stimme zu</label>
                                </div>

                            {% else %}
                                <div class="group">
                                    <input type="{{ type }}" name="{{ field }}" required>
                                    <span class="highlight"></span>
                                    <span class="bar"></span>
                                    <label>{{ field|capitalize }}</label>
                                </div>
                            {% endif %}

                        {% endfor %}
                    {% endif %}

                    <div class="button-wrapper">
                        <button type="submit" class="login-submit">
                            Absenden
                        </button>
                    </div>

                </form>
            </div>

        {% endif %}

    {% endfor %}

</section>