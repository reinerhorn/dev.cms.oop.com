{% set config   = block.config is iterable ? block.config : {} %}
{% set fields   = config.fields ?? [] %}
{% set intent   = block.intent ?? config.intent ?? '' %}
{% set handler  = block.handler ?? config.handler ?? '' %}
{% set redirect = config.redirect ?? null %}
{% set form_class = block.form_class ?? config.form_class ?? null %}
{% if block.wrapper_class is defined %}
<div class="{{ block.wrapper_class }}">
{% endif %}

<form
    method="post"
    {% if form_class is not empty %}class="{{ form_class }}"{% endif %}
>           {% if form_type is not empty %}
                <input type="hidden" name="form_type" value="{{ form_type }}">
    {% endif %}

    {% if redirect %}
        <input type="hidden" name="redirect" value="{{ redirect }}">
    {% endif %}

    {% if block.headline %}
        <h1>{{ block.headline }}</h1>
    {% endif %}

    {% if block.text %}
        <div data-form-text>
            {{ block.text|raw }}
        </div>
    {% endif %}

    <div data-form-messages></div>

    {% for field in fields %}
        {% set type = field.type|default('text') %}

        {% if type == 'checkbox' %}
            <label>
                <input
                    type="checkbox"
                    name="{{ field.name }}"
                    {% if field.required %}required{% endif %}
                >
                {{ field.label }}
            </label>

        {% elseif type == 'textarea' %}
            <textarea
                name="{{ field.name }}"
                placeholder="{{ field.label }}"
                {% if field.required %}required{% endif %}
            ></textarea>

        {% else %}
            <input
                type="{{ type }}"
                name="{{ field.name }}"
                placeholder="{{ field.label }}"
                {% if field.required %}required{% endif %}
            >
        {% endif %}
    {% endfor %}

    <button type="submit">
        {{ config.submit_label }}
    </button>

</form>
{% if block.wrapper_class is defined %}
</div>
{% endif %}