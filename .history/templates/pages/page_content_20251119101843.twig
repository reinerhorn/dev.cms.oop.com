{% set blocks = data.content_data is defined ? data.content_data : content_data %}

<pre>
{{ dump(blocks) }}
</pre>

<section class="page-content">
    {% if blocks %}
        {% for block in blocks %}

            {# Plaintext #}
            {% if (block.headline is defined and block.headline|trim != '') 
                or (block.text is defined and block.text|trim != '') %}
                <article class="content-block">
                    {% if block.headline is defined %}
                        <h1 class="content-headline">{{ block.headline }}</h1>
                    {% endif %}
                    {% if block.text is defined %}
                        <div class="content-text">
                            {{ block.text|raw }}
                        </div>
                    {% endif %}
                </article>
            {% endif %}

            {# LOGIN FORM #}
            {% if block.type is defined and block.type == 'login_form' %}
                {% include "partials/login_form.twig" with {
                    headline: block.headline,
                    text: block.text,
                    config: block.config
                } %}
            {% endif %}

        {% endfor %}
    {% endif %}
</section>