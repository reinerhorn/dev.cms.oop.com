{# pages/page_content.twig #}

{% set blocks = data.content_data is defined ? data.content_data : content_data %}

<div id="content">

    {% if blocks is empty %}
        <p class="content-text">Keine Inhalte vorhanden.</p>
    {% endif %}

    {% for block in blocks %}

        {# ---------- PLAIN TEXT BLOCK ---------- #}
        {% if block.type == 'plaintext' %}
            <article class="content-block">
                {% if block.headline %}
                    <h1 class="content-headline">{{ block.headline }}</h1>
                {% endif %}
                {% if block.text %}
                    <div class="content-text">{{ block.text|raw }}</div>
                {% endif %}
            </article>
        {% endif %}

        {# ---------- FORMULAR BLOCK (login_form, register, etc.) ---------- #}
        {% if block.type ends with '_form' or block.type == 'form' %}
            <section class="form-block">
                {% if block.headline %}
                    <h1 class="content-headline">{{ block.headline }}</h1>
                {% endif %}
                {% if block.text %}
                    <div class="content-text">{{ block.text|raw }}</div>
                {% endif %}

                {% set fields = block.config.fields is defined ? block.config.fields : [] %}

                <form method="post" class="dynamic-form">
                    {% if 'email' in fields %}
                        <input type="email" name="email" placeholder="E-Mail" required>
                    {% endif %}
                    {% if 'password' in fields %}
                        <input type="password" name="password" placeholder="Passwort" required>
                    {% endif %}
                    {% if 'agree' in fields %}
                        <label>
                            <input type="checkbox" name="agree"> Ich stimme zu
                        </label>
                    {% endif %}

                    {# Extra dynamische Felder aus config.extra_fields #}
                    {% if block.config.extra_fields is defined %}
                        {% for field in block.config.extra_fields %}
                            <input type="{{ field.type }}" name="{{ field.name }}" placeholder="{{ field.placeholder }}">
                        {% endfor %}
                    {% endif %}

                    <button type="submit">Absenden</button>
                </form>
            </section>
        {% endif %}

    {% endfor %}
</div>