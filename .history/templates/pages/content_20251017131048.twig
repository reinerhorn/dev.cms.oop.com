{% set show_debug = (constant('CMS_DEBUG') and app.request.get('debug') == '1') %}

{% if contents is defined and contents is not empty %}
    {% if show_debug %}
        <div class="content-debug">
            <h3>🧩 DEBUG: Inhalte aus PluginPlaintext::getContent()</h3>
            <pre>{{ dump(contents) }}</pre>
        </div>
    {% endif %}

    <section class="page-content">
        {% for label, blocks in contents %}
            {% for block in blocks %}
                {% if block.headline or block.text %}
                    <article class="content-block">
                        {% if block.headline %}
                            <h2>{{ block.headline }}</h2>
                        {% endif %}
                        {% if block.text %}
                            <div class="content-text">
                                {{ block.text|raw }}
                            </div>
                        {% endif %}
                    </article>
                {% endif %}
            {% endfor %}
        {% endfor %}
    </section>
{% else %}
    <p>Keine Inhalte gefunden.</p>
{% endif %}