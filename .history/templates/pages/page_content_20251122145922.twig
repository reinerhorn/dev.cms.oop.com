{# pages/page_content.twig — NEU #}

{% set blocks = data.content_data is defined ? data.content_data : content_data %}

<section class="page-content">

    {% if blocks is empty %}
        <section class="error">
            <h2>Keine Inhalte gefunden</h2>
            <p class="content-text">Diese Seite enthält keine Inhalte oder Plugin-Daten.</p>
        </section>
    {% endif %}

    {% for block in blocks %}

        <article class="content-block">

            {# HEADLINE — wenn vorhanden #}
            {% if block.headline is defined and block.headline|trim != '' %}
                <h1 class="content-headline">{{ block.headline }}</h1>
            {% endif %}

            {# PLAINTEXT — wenn vorhanden #}
            {% if block.text is defined and block.text|trim != '' %}
                <div class="content-text">{{ block.text|raw }}</div>
            {% endif %}

            {# FORMULAR — wenn config vorhanden ist #}
            {% if block.config is defined and block.config.fields is defined %}
                <section class="form-section">

                    <form method="post" class="dynamic-form">

                        {% for field in block.config.fields %}

                            {% if field == 'email' %}
                                <div class="form-row">
                                    <label for="email">E-Mail</label>
                                    <input id="email" type="email" name="email" required>
                                </div>
                            {% endif %}

                            {% if field == 'password' %}
                                <div class="form-row">
                                    <label for="password">Passwort</label>
                                    <input id="password" type="password" name="password" required>
                                </div>
                            {% endif %}

                            {% if field == 'agree' %}
                                <div class="form-row">
                                    <label class="checkbox">
                                        <input type="checkbox" name="agree"> Ich stimme zu
                                    </label>
                                </div>
                            {% endif %}

                        {% endfor %}

                        {# Dynamisch erweiterbare Felder #}
                        {% if block.config.extra_fields is defined %}
                            {% for f in block.config.extra_fields %}
                                <div class="form-row">
                                    <label>{{ f.label }}</label>
                                    <input type="{{ f.type|default('text') }}"
                                           name="{{ f.name }}"
                                           placeholder="{{ f.placeholder|default('') }}">
                                </div>
                            {% endfor %}
                        {% endif %}

                        <div class="form-actions">
                            <button type="submit">Absenden</button>
                        </div>

                    </form>

                </section>
            {% endif %}

        </article>

    {% endfor %}
</section>