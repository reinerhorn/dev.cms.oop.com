{# pages/page_content.twig #}

{% set blocks = data.content_data is defined ? data.content_data : content_data %}

<section class="page-content">

    {% if blocks is empty %}
        <section class="error">
            <h2>Keine Inhalte gefunden</h2>
            <p class="content-text">Diese Seite enthält keine Inhalte oder ein Plugin ist falsch konfiguriert.</p>
        </section>
    {% endif %}

    {% for block in blocks %}

        {# --------------------------------------------------------- #}
        {#                  PLAIN TEXT RENDERING                    #}
        {# --------------------------------------------------------- #}
        {% if block.type == 'plaintext' %}
            <article class="content-block">
                {% if block.headline is defined and block.headline|trim != '' %}
                    <h1 class="content-headline">{{ block.headline }}</h1>
                {% endif %}

                {% if block.text is defined and block.text|trim != '' %}
                    <div class="content-text">{{ block.text|raw }}</div>
                {% endif %}
            </article>
        {% endif %}

        {# --------------------------------------------------------- #}
        {#               FORMULAR DIREKT AUS DER DATENBANK          #}
        {# --------------------------------------------------------- #}

        {% if block.type == 'login_form' 
           or block.type == 'register'
           or block.type ends with '_form'
           or block.type == 'form' %}

            <section class="form-section">

                {% if block.headline is defined and block.headline|trim != '' %}
                    <h2 class="form-headline">{{ block.headline }}</h2>
                {% endif %}

                {% if block.text is defined and block.text|trim != '' %}
                    <div class="form-text">{{ block.text|raw }}</div>
                {% endif %}

                {# Formular-Konfiguration aus DB #}
                {% set config = block.config is defined ? block.config : {} %}
                {% set fields = config.fields is defined ? config.fields : [] %}

                <form method="post" class="dynamic-form">

                    {# Dynamische Felder #}

                    {% if 'email' in fields %}
                        <div class="form-row">
                            <label for="email">E-Mail</label>
                            <input id="email" type="email" name="email" required>
                        </div>
                    {% endif %}

                    {% if 'password' in fields %}
                        <div class="form-row">
                            <label for="password">Passwort</label>
                            <input id="password" type="password" name="password" required>
                        </div>
                    {% endif %}

                    {% if 'agree' in fields %}
                        <div class="form-row">
                            <label class="checkbox">
                                <input type="checkbox" name="agree"> Ich stimme zu
                            </label>
                        </div>
                    {% endif %}

                    {# Extra-Felder (falls vorhanden) #}
                    {% if config.extra_fields is defined %}
                        {% for f in config.extra_fields %}
                            <div class="form-row">
                                <label>{{ f.label|default('') }}</label>
                                <input type="{{ f.type|default('text') }}"
                                       name="{{ f.name }}"
                                       placeholder="{{ f.placeholder|default('') }}">
                            </div>
                        {% endfor %}
                    {% endif %}

                    <div class="form-actions">
                        <button type="submit">Absenden</button>
                    </div>

                </form>

            </section>

        {% endif %}

    {% endfor %}
</section>