{% block content %}
 
    <section class="page-content">

        {# Alle Blöcke durchlaufen (Plaintext, Formulare, Bilder, etc.) #}
        {% for block in blocks %}

            {# PLAIN TEXT BLOCK #}
            {% if block.type == "plaintext" %}
                {% if block.headline %}
                    <h1 class="content-headline">{{ block.headline }}</h1>
                {% endif %}
                {% if block.text %}
                    <div class="content-text">{{ block.text|raw }}</div>
                {% endif %}
            {% endif %}

            {# LOGIN FORMULAR BLOCK #}
            {% if block.type == "login_form" %}
                {% include "pages/login.twig" with block.data %}
            {% endif %}

        {% endfor %}
    </section>
 
{% endblock %}