{# -------------------------------
   1) Rolle bestimmen
   ------------------------------- #}
{% set role_numeric = 0 %}

{% if session.role_id is defined %}
    {% set r = session.role_id %}

    {% if r starts with('admin') %}
        {% set role_numeric = 1 %}
    {% elseif r starts with('member') %}
        {% set role_numeric = 2 %}
    {% else %}
        {% set role_numeric = 0 %}
    {% endif %}
{% endif %}


<header class="{{ header.css|default('header') }}">
    <div class="header-top">

        {# ------------------------------------
           2) LINKER BEREICH → Logo(s)
           ------------------------------------ #}
        <div class="header-left">

            {% for h in header.data %}
                {# Zeige nur Header-Eintrag wenn role passt oder kein role gesetzt ist #}
                {% if h.role is not defined
                    or h.role == ''
                    or (h.role is not null and h.role|number_format(0) == role_numeric)
                %}

                    {% if h.images is defined and h.images is iterable %}
                        {% for image in h.images %}
                            <a href="{{ image.link_url }}">
                                <img 
                                    class="logo" 
                                    src="{{ asset_path }}/{{ image.image_url }}" 
                                    alt="{{ image.alt_text }}">
                            </a>
                        {% endfor %}
                    {% endif %}

                {% endif %}
            {% endfor %}
        </div>


        {# ------------------------------------
           3) MITTE → Headline nach Rolle
           ------------------------------------ #}
        <div class="header-center">

            {% set headerItems = header.data is iterable ? header.data : [] %}

            {% set activeHeader = headerItems
                |filter(h => (h.role is not null and h.role|number_format(0) == role_numeric))
                |first 
            %}

            {% if activeHeader %}
                <span class="companyname">{{ activeHeader.headline }}</span>
            {% else %}
                <span class="companyname">{{ header.headline|default('') }}</span>
            {% endif %}
        </div>


        {# ------------------------------------
           4) RECHTS → Language Switcher
           ------------------------------------ #}
        <div class="header-right">
            {% include 'partials/language_selector.twig' %}
        </div>

    </div>
</header>