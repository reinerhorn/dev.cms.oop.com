<footer class="footer">
    <div class="footer-container">
        <!-- Footer Navigation -->
        <div class="footer-nav">
            {% if footer.navigation is not empty %}
                <ul>
                    {% for item in footer.navigation %}
                        <li>
                            <a href="{{ item.url }}" title="{{ item.title }}">{{ item.title }}</a>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p>Keine zusätzlichen Links verfügbar</p>
            {% endif %}
        </div>

        <!-- Firmeninformationen -->
        <div class="footer-info">
            <p>&copy; 2020 - {{ "now"|date("Y") }} {{ footer.company_name }}</p>
            <p>{{ footer.slogan ?: 'Ihre Dienstleistungspartner' }}</p>
        </div>

        <!-- Social Media Icons -->
        <div class="footer-social">
            {% if footer.social_links is not empty %}
                <ul class="social-icons">
                    {% for social in footer.social_links %}
                        <li>
                            <a href="{{ social.url }}" target="_blank" rel="noopener" title="{{ social.name }}">
                                <img src="/images/icons/{{ social.icon }}.svg" alt="{{ social.name }}">
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
</footer>