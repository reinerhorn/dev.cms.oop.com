<nav id="{{ navId }}" class="main-nav nav-admin">

    <!-- LINKS -->
    <ul class="nav-group nav-left">
        {% for item in navigation %}
            {% if item.align is not defined or item.align != 'right' %}
                <li class="nav-item{% if item.children is defined and item.children|length %} has-dropdown{% endif %}{% if item.active %} active{% endif %}">
                    {% if item.children is defined and item.children|length %}
                        <span class="nav-title">{{ item.title }}</span>
                        <ul class="dropdown-menu">
                            {% for sub in item.children %}
                                <li class="nav-sub-item">
                                    <a href="{{ sub.url }}">{{ sub.title }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <a href="{{ item.url }}">{{ item.title }}</a>
                    {% endif %}
                </li>
            {% endif %}
        {% endfor %}
    </ul>

    <!-- RECHTS -->
  <ul class="nav-group nav-right">
    {% for item in navigation %}
        {% if item.align == 'right' %}

            {% if item.is_logout %}
                <li class="nav-item nav-logout">
                    <form method="post" action="/ajax/auth.php">
                        <input type="hidden" name="intent" value="logout">
                        <button type="submit" class="nav-link logout">
                            {{ item.title }}
                        </button>
                    </form>
                </li>
            {% else %}
                <li class="nav-item{% if item.active %} active{% endif %}">
                    <a href="{{ item.url }}">{{ item.title }}</a>
                </li>
            {% endif %}

        {% endif %}
    {% endfor %}
</ul>

</nav>