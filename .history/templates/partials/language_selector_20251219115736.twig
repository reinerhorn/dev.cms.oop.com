<div id="LanguageSelector" class="language-dropdown">
    <button
        type="button"
        class="language-button"
        id="lang-toggle"
        aria-haspopup="true"
        aria-expanded="false"
    >
        {% if current_flag_path %}
            <img src="{{ current_flag_path }}" alt="{{ current_lang }} flag" />
        {% else %}
            <span class="current-language-flag">{{ current_flag }}</span>
        {% endif %}
        <span class="arrow">▼</span>
    </button>

    <ul class="language-list" id="lang-list">
        {% for lang in all_languages %}
            <li
                class="language-option{% if lang.id == current_lang %} active{% endif %}"
                data-lang="{{ lang.id }}"
            >
                {% if lang.flag_path %}
                    <img src="{{ lang.flag_path }}" alt="{{ lang.label }} flag" />
                {% else %}
                    {{ lang.flag }}
                {% endif %}
                {{ lang.label }}
            </li>
        {% endfor %}
    </ul>
</div>