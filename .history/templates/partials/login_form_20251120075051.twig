{% extends "layout/base.twig" %}

{% block content %}
<main id="content">
  <section class="page-content login-page">
    {# Plaintext-Headline/Text (CMS-Inhalte) #}
    {% if plugin_headline %}
      <h1 class="content-headline">{{ plugin_headline }}</h1>
    {% else %}
      <h1 class="content-headline">Login</h1>
    {% endif %}

    {% if plugin_text %}
      <div class="content-text">
        {{ plugin_text|raw }}
      </div>
    {% endif %}

    {# Plugin-Formular #}
    <form method="post" action="" class="login-form">
      <input type="email" name="email" value="{{ email|default('') }}" placeholder="E-Mail" required>
      <input type="password" name="password" placeholder="Passwort" required>
      <label><input type="checkbox" name="agree" {% if agree %}checked{% endif %}> Ich stimme zu</label>
      <button type="submit">Einloggen</button>
    </form>
  </section>
</main>
{% endblock %}