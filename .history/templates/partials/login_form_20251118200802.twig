<section class="login-form-block">

    {# Headline #}
    {% if headline is defined and headline|trim != '' %}
        <h1 class="content-headline">{{ headline }}</h1>
    {% endif %}

    {# Text #}
    {% if text is defined and text|trim != '' %}
        <div class="content-text">{{ text|raw }}</div>
    {% endif %}

    {# Fallback, falls config oder config.fields fehlt #}
    {% set fields = config.fields is defined ? config.fields : [] %}

    <form method="post" action="" class="login-form">

        {# --- E-Mail Feld --- #}
        {% if 'email' in fields %}
            <input type="email"
                   name="email"
                   placeholder="E-Mail"
                   required>
        {% endif %}

        {# --- Passwort Feld --- #}
        {% if 'password' in fields %}
            <input type="password"
                   name="password"
                   placeholder="Passwort"
                   required>
        {% endif %}

        {# --- Agree Checkbox --- #}
        {% if 'agree' in fields %}
            <label class="login-checkbox">
                <input type="checkbox" name="agree">
                Ich stimme zu
            </label>
        {% endif %}

        {# --- Extra dynamische Felder --- #}
        {% if config.extra_fields is defined %}
            {% for field in config.extra_fields %}
                <input type="{{ field.type }}"
                       name="{{ field.name }}"
                       placeholder="{{ field.placeholder }}">
            {% endfor %}
        {% endif %}

        {# --- Wenn KEIN EINZIGES Feld existiert → Minimal-Fallback anzeigen --- #}
        {% if fields is empty %}
            <p class="content-text" style="color:red;">
                ⚠️ Keine Formularfelder definiert. Bitte im Adminbereich konfigurieren.
            </p>
        {% endif %}

        <button type="submit" class="login-button">Einloggen</button>

    </form>
</section>