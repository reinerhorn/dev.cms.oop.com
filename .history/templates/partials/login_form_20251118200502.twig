<section class="login-form-block">

    {# Headline #}
    {% if headline is defined and headline|trim != '' %}
        <h1 class="content-headline">{{ headline }}</h1>
    {% endif %}

    {# Text #}
    {% if text is defined and text|trim != '' %}
        <div class="content-text">{{ text|raw }}</div>
    {% endif %}

    {# Formular #}
    <form method="post" action="" class="login-form">

        {# Dynamische Felder aus config_json #}

        {# --- E-Mail --- #}
        {% if config.fields is defined and 'email' in config.fields %}
            <input type="email"
                   name="email"
                   value=""
                   placeholder="E-Mail"
                   required>
        {% endif %}

        {# --- Passwort --- #}
        {% if config.fields is defined and 'password' in config.fields %}
            <input type="password"
                   name="password"
                   placeholder="Passwort"
                   required>
        {% endif %}

        {# --- Agree Checkbox --- #}
        {% if config.fields is defined and 'agree' in config.fields %}
            <label class="login-checkbox">
                <input type="checkbox" name="agree">
                Ich stimme zu
            </label>
        {% endif %}

        {# --- Weitere Felder für die Zukunft --- #}
        {% if config.extra_fields is defined %}
            {% for field in config.extra_fields %}
                <input type="{{ field.type }}"
                       name="{{ field.name }}"
                       placeholder="{{ field.placeholder }}">
            {% endfor %}
        {% endif %}

        <button type="submit" class="login-button">Einloggen</button>

    </form>
</section>
 