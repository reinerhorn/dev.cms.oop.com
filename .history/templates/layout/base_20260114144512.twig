<!DOCTYPE html>
<html lang="{{ language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ meta.title|default('Meine Seite') }}</title>
    <meta name="description" content="{{ meta.description|default('Standardbeschreibung') }}">
    <meta name="keywords" content="{{ meta.keywords|default('CMS,OOP,PHP,Twig') }}">
    <link rel="icon" href="{{ asset_path }}/assets/images/icon/favicon.ico" type="image/x-icon">

    {% for css in css_files %}
        <link rel="stylesheet" href="{{ asset_path }}/assets/css/{{ css }}?v={{ "now"|date('U') }}">
    {% endfor %}

     <script src="/assets/js/Language_Selector.js" defer></script>
     
</head>
<body>
    {# Flash Messages #}
    {% if session.flash_success is defined %}
        <div class="flash flash-success">{{ session.flash_success }}</div>
    {% endif %}

    {% if session.flash_error is defined %}
        <div class="flash flash-error">{{ session.flash_error }}</div>
    {% endif %}

    {# Header #}
    {% if header is defined and header %}
        {% include 'partials/header.twig' with { header: header } %}
    {% endif %}

    {# Navigation #}
   {% include 'partials/navigation.twig' with {
    navigation: navigation,
    navRole: navRole
} %}

    {# ===============================
       HAUPTINHALT → BLOCK LOOP
       =============================== #}

    <main class="content">

        {% if content_data is not defined or content_data is empty %}
            {# Fallback, wenn wirklich GAR KEINE Inhalte #}
            <div style="margin:2em auto;max-width:600px;padding:2em;text-align:center;border:1px solid #eee;border-radius:8px;background:#fafafa;">
                <h1 style="font-size:2em;margin-bottom:0.5em;color:#c00;">Keine Inhalte gefunden</h1>
                <p>Es wurde kein gültiges Content-Template geladen.</p>
            </div>
        {% else %}

   {% for block in content_data %}
  <!-- DEBUG BLOCK -->
    <!-- Block-Type: {{ block.type }} -->
    {# PLAINTEXT → direkt ausgeben #}
    {% if block.type == 'plaintext' %}
        <article class="content-block">
            {% if block.headline %}
                <h1 class="content-headline">{{ block.headline }}</h1>
            {% endif %}
            {% if block.text %}
                <div class="content-text">{{ block.text|raw }}</div>
            {% endif %}
        </article>

    {% else %}

        {# 🔥 DYNAMISCHES TEMPLATE #}
        {% set tpl = 'pages/' ~ block.type ~ '.twig' %}

        {# Template laden → ignoriert fehlende Dateien #}
        {% include tpl ignore missing with { block:block, layout_disabled:true } %}

    {% endif %}

{% endfor %}
{% endif %}</main>
{# Footer #}
{% if footer is defined and footer %}
    {% include 'partials/footer.twig' with { footer: footer } %}
{% endif %}
 {% if debug %}
<div style="
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    background:#111;
    color:#0f0;
    font-family:monospace;
    font-size:12px;
    padding:10px;
    z-index:9999;
">
    <strong>Twig Debug</strong><br>

    logged_in: {{ auth.logged_in ? 'YES' : 'NO' }}<br>
    user_id: {{ auth.user_id ?? 'NULL' }}<br>
    role_id: {{ auth.role_id ?? 'NULL' }}<br>
    navRole: {{ navRole }}<br>
    navId: {{ navId }}<br>

    <hr>
    debug_info:<br>
    <pre>{{ debug_info|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
</div>
{% endif %} 

</body>
</html>