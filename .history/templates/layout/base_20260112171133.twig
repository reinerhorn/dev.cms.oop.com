<!DOCTYPE html>
<html lang="{{ language|default('de') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ meta.title|default('Meine Seite') }}</title>

    {% if css_files is defined %}
        {% for css in css_files %}
            <link rel="stylesheet" href="{{ asset_path }}/assets/css/{{ css }}">
        {% endfor %}
    {% endif %}
</head>
<body>

{# =========================
   🔥 HARTER TWIG TEST
   ========================= #}
<div style="
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    background:red;
    color:white;
    font-family:monospace;
    font-size:14px;
    padding:10px;
    z-index:999999;
">
    <strong>TWIG IST DA ✅</strong><br>

    debug:
    {% if debug is defined %}
        {{ debug }}
    {% else %}
        NOT_DEFINED
    {% endif %}
    <br>

    auth.logged_in:
    {% if auth is defined and auth.logged_in is defined %}
        {{ auth.logged_in }}
    {% else %}
        NOT_DEFINED
    {% endif %}
</div>

{# =========================
   NORMALER SEITENAUFBAU
   ========================= #}

{% if header is defined %}
    {% include 'partials/header.twig' ignore missing %}
{% endif %}

{% if navigation is defined %}
    {% include 'partials/navigation.twig' ignore missing %}
{% endif %}

<main>
    {% if content_data is defined %}
        {% for block in content_data %}
            <pre>{{ dump(block) }}</pre>
        {% endfor %}
    {% else %}
        <p>NO CONTENT_DATA</p>
    {% endif %}
</main>

{% if footer is defined %}
    {% include 'partials/footer.twig' ignore missing %}
{% endif %}

</body>
</html>