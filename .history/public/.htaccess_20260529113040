<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 🔓 verify.php IMMER direkt ausführen
    RewriteRule ^verify$ verify.php [L,QSA]
    # Browser-Standarddateien nicht an index.php weiterleiten
    RewriteRule ^(favicon\.ico|robots\.txt|manifest\.json|apple-touch-icon\.png)$ - [L]

    # Wenn Datei oder Verzeichnis existiert → direkt ausliefern
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Alles andere an index.php weiterleiten
    RewriteRule ^ index.php [QSA,L]
</IfModule>