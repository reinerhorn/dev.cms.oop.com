<?php
use CMS\Plugin\PluginFormular;
use mysqli;

$db = new mysqli('localhost', 'user', 'password', 'dbs_cms_oop');
$language = 'de';
$pageId = '73a6cb4c-7bf6-11f0-be30-c26cf33f6ee6'; // Login-Seite UUID

$pluginFormular = new PluginFormular($db);

// Lade den page_config-Eintrag für login-form
$stmt = $db->prepare("
    SELECT plugin_content_uuid 
    FROM page_config 
    WHERE fk_page_uuid = ? 
      AND fk_plugin_uuid = (
            SELECT plugin_uuid FROM plugin WHERE name = 'login-form'
      )
    LIMIT 1
");
$stmt->bind_param('s', $pageId);
$stmt->execute();
$uuid = $stmt->get_result()->fetch_assoc()['plugin_content_uuid'];
$stmt->close();

// Lade Formular-Inhalt
$form = $pluginFormular->loadContentByLanguage($uuid, $language);

// Debug-Ausgabe
echo "<pre>";
print_r($form);
echo "</pre>";