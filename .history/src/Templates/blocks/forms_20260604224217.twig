{% if t is not defined %}
    {% macro t(key) %}{{ key }}{% endmacro %}
    {% import _self as i18n %}
{% endif %}
{% set config      = block.config is iterable ? block.config : {} %}
 

{# kompatibel mit alter + neuer Formularstruktur #}
{% set fields = block.fields ?? config.fields ?? block.form.fields ?? [] %}
{% set form_class = block.form_class ?? config.form_class ?? null %}

<div class="admin-form-wrapper">

<pre>

FORM_RESULT:

{{ dump(form_result) }}

</pre>
 
{# Formular-Feedback (zentral aus CMSAppFrontend) #}
{% if form_result is defined %}
    {% if form_result.message %}
        <div class="form-message {{ form_result.status == 'ok' ? 'form-success' : 'form-error' }}">
            {{ form_result.message }}
        </div>
    {% endif %}

    {% if form_result.errors is defined and form_result.errors is iterable and form_result.errors|length > 0 %}
        <ul class="form-errors">
            {% for error in form_result.errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endif %}

<form
    method="{{ config.method|default('post') }}"
    data-form
    {% if form_class is not empty %}class="{{ form_class }}"{% endif %}
>
   
        <input type="hidden" name="_csrf" value="{{ csrf }}">
    

    {# eindeutige Formular-ID zur Plugin-Isolation #}
    {% if config.form_id is defined %}
        <input type="hidden" name="form_id" value="{{ config.form_id }}">
    {% endif %}

    {% if block.headline %}
        <h1>{{ block.headline }}</h1>
    {% endif %}

    {% if block.text %}
        <div data-form-text>
            {{ block.text|raw }}
        </div>
    {% endif %}


    {% for field in fields %}

        {% set ui = field.ui ?? {} %}
        {% set db = field.db ?? {} %}

        {# kompatibel alt + neu #}
        {% set type = field.type ?? ui.type|default('text') %}
        {% set required = field.required ?? db.required|default(false) %}

        {% set field_name = field.name|default('') %}
        {% set field_id = field.id ?? ui.id|default(field_name) %}

        {% set field_label = field.label is iterable
            ? (field.label.text|default(field_name))
            : (field.label|default(field_name)) %}

        {# options kompatibel alt + neu #}
        {% set options = field.options ?? ui.options ?? [] %}

    {% if type == 'checkbox' %}
        <div class="checkbox-group">
            <input type="hidden" name="{{ field_name }}" value="0">
            <label>
                <input
                    type="checkbox"
                    name="{{ field_name }}"
                    value="1"
                    {% if field.value is defined and field.value in [1, '1', true, 'true', 'on'] %}
                        checked
                    {% endif %}
                    {% if required %}required{% endif %}
                >
                {{ field_label }}
            </label>
        </div>

    {% elseif type == 'textarea' %}
            <textarea
                name="{{ field_name }}"
                placeholder="{{ field_label }}"
                {% if required %}required{% endif %}
            >{{ field.value|default('') }}</textarea>

        {% elseif type == 'select' %}
            <div class="form-group">
                <label for="{{ field_id }}">{{ field_label }}</label>

                {# aktuelle Auswahl sauber und typsicher bestimmen #}
                {% set current_value = (field.value is defined and field.value is not null)
                    ? (field.value ~ '')
                    : '' %}

                <select
                    id="{{ field_id }}"
                    name="{{ field_name }}"
                    {% if field_name ends with '_load_id' %}
                        data-redirect-on-change="1"
                    {% endif %}
                    {% if required %}required{% endif %}
                >

                    <option value=""
                        {% if current_value == '' %}selected="selected"{% endif %}>
                        -- neu --
                    </option>

                    {% if options is iterable and options|length > 0 %}
                        {% for option in options %}
                            {% set option_value = option.value ~ '' %}
                            <option value="{{ option_value }}"
                                {% if option_value == current_value %}selected="selected"{% endif %}>
                                {{ option.label }}
                            </option>
                        {% endfor %}
                    {% endif %}
                </select>
            </div>

        {% else %}
            <div class="form-group">
                <input
                    type="{{ type }}"
                    id="{{ field_id }}"
                    name="{{ field_name }}"
                    value="{{ field.value|default('') }}"
                    placeholder=" "
                    {% if required %}required{% endif %}
                >
                <label for="{{ field_id }}">{{ field_label }}</label>
            </div>
        {% endif %}
    {% endfor %}
  
    {% if block.buttons is defined and block.buttons is iterable and block.buttons|length > 0 %}
        <div class="form-actions">
            {% for button in block.buttons %}
                <button
                    type="{{ button.button_type }}"
                    class="btn btn-{{ button.variant }}"
                    {% if button.action %}name="action" value="{{ button.action }}"{% endif %}
                 
                    {% if button.confirm_required %}data-confirm="1"{% endif %}
                >
                    {{ button.label_key }}
                </button>
            {% endfor %}
        </div>
    {% endif %}
</form>
</div>