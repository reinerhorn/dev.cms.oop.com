{% set editor = block.editor ?? {} %}
{% set fields = editor.fields ?? [] %}

<form method="post">

    {% for field in fields %}

        {% set ui = field.ui ?? {} %}
        {% set db = field.db ?? {} %}

        {% set type = ui.type|default('text') %}
        {% set name = field.name|default('') %}
        {% set label = field.label.text|default(name) %}

        <div class="form-group">

            <label>
                {{ label }}
            </label>

            {% if type == 'select' %}

                <select name="{{ name }}">

                    {% if ui.options is defined %}

                        {% for option in ui.options %}

                            <option value="{{ option.value }}">
                                {{ option.label }}
                            </option>

                        {% endfor %}

                    {% endif %}

                </select>

            {% else %}

                <input
                    type="{{ type }}"
                    name="{{ name }}"
                >

            {% endif %}

        </div>

    {% endfor %}

</form>
