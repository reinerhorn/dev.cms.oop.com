{% if t is not defined %}
    {% macro t(key) %}{{ key }}{% endmacro %}
    {% import _self as i18n %}
{% endif %}

{# -------------------------------------------------- #}
{# DATA STRUCTURE                                     #}
{# -------------------------------------------------- #}

{% set data = block.data ?? {} %}

{% set fields      = data.fields ?? [] %}
{% set form_class  = data.form_class ?? null %}

<div class="admin-form-wrapper">

{# -------------------------------------------------- #}
{# FORM FEEDBACK                                      #}
{# -------------------------------------------------- #}

{% if form_result is defined %}
    
    {% if form_result.message %}
        <div class="form-message {{ form_result.status == 'ok' ? 'form-success' : 'form-error' }}">
            {{ form_result.message }}
        </div>
    {% endif %}

    {% if form_result.errors is defined 
        and form_result.errors is iterable 
        and form_result.errors|length > 0 %}
        
        <ul class="form-errors">
            {% for error in form_result.errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>

    {% endif %}
{% endif %}

<form
    method="{{ data.method|default('post') }}"
    data-form
    {% if form_class is not empty %}
        class="{{ form_class }}"
    {% endif %}
>

    <input type="hidden" name="_csrf" value="{{ csrf }}">

    {# -------------------------------------------------- #}
    {# FORM ID                                            #}
    {# -------------------------------------------------- #}

    {% if data.form_id is defined %}
        <input type="hidden" name="form_id" value="{{ data.form_id }}">
    {% endif %}

    {# -------------------------------------------------- #}
    {# HEADLINE / TEXT                                    #}
    {# -------------------------------------------------- #}

    {% if data.headline %}
        <h1>{{ data.headline }}</h1>
    {% endif %}

    {% if data.text %}
        <div data-form-text>
            {{ data.text|raw }}
        </div>
    {% endif %}

    <pre>DEBUG FIELDS: {{ fields|length }}</pre>

    {# -------------------------------------------------- #}
    {# FIELDS                                             #}
    {# -------------------------------------------------- #}

    {% for field in fields %}

        {% set type = field.ui.type|default(field.type|default('text')) %}
        {% set field_name = field.name|default('') %}
        {% set field_id = field.ui.id|default(field_name) %}

        {% set field_label = field.label is iterable
            ? (field.label.text|default(field_name))
            : (field.label|default(field_name))
        %}

        {% set field_required = field.db.required|default(false) %}

        {# -------------------------------------------------- #}
        {# CHECKBOX                                          #}
        {# -------------------------------------------------- #}

        {% if type == 'checkbox' %}

            <div class="checkbox-group">

                <input type="hidden" name="{{ field_name }}" value="0">

                <label>

                    <input
                        type="checkbox"
                        id="{{ field_id }}"
                        name="{{ field_name }}"
                        value="1"

                        {% if field.value is defined and field.value == 1 %}
                            checked
                        {% endif %}

                        {% if field_required %}
                            required
                        {% endif %}
                    >

                    {{ field_label }}

                </label>

            </div>

        {# -------------------------------------------------- #}
        {# TEXTAREA                                           #}
        {# -------------------------------------------------- #}

        {% elseif type == 'textarea' %}

            <div class="form-group">

                <textarea
                    id="{{ field_id }}"
                    name="{{ field_name }}"
                    placeholder="{{ field_label }}"

                    {% if field_required %}
                        required
                    {% endif %}
                >{{ field.value|default('') }}</textarea>

            </div>

        {# -------------------------------------------------- #}
        {# SELECT                                             #}
        {# -------------------------------------------------- #}

        {% elseif type == 'select' %}

            <div class="form-group">

                <label for="{{ field_id }}">
                    {{ field_label }}
                </label>

                {% set current_value = field.value is defined and field.value is not null
                    ? (field.value ~ '')
                    : ''
                %}

                <select
                    id="{{ field_id }}"
                    name="{{ field_name }}"

                    {% if field.ui.auto_submit|default(false) %}
                        data-redirect-on-change="1"
                    {% endif %}

                    {% if field_required %}
                        required
                    {% endif %}
                >

                    <option value=""
                        {% if current_value == '' %}
                            selected="selected"
                        {% endif %}
                    >
                        -- neu --
                    </option>

                    {% if field.ui.options is defined and field.ui.options is iterable %}

                        {% for option in field.ui.options %}

                            {% set option_value = option.value ~ '' %}

                            <option
                                value="{{ option_value }}"

                                {% if option_value == current_value %}
                                    selected="selected"
                                {% endif %}
                            >
                                {{ option.label }}
                            </option>

                        {% endfor %}

                    {% endif %}

                </select>

            </div>

        {# -------------------------------------------------- #}
        {# STANDARD INPUT                                     #}
        {# -------------------------------------------------- #}

        {% else %}

            <div class="form-group">

                <input
                    type="{{ type }}"
                    id="{{ field_id }}"
                    name="{{ field_name }}"
                    value="{{ field.value|default('') }}"
                    placeholder=" "

                    {% if field_required %}
                        required
                    {% endif %}
                >

                <label for="{{ field_id }}">
                    {{ field_label }}
                </label>

            </div>

        {% endif %}

    {% endfor %}

    {# -------------------------------------------------- #}
    {# BUTTONS                                            #}
    {# -------------------------------------------------- #}

    {% if block.buttons is defined 
        and block.buttons is iterable 
        and block.buttons|length > 0 %}

        <div class="form-actions">

            {% for button in block.buttons %}

                <button
                    type="{{ button.button_type|default('submit') }}"
                    class="btn btn-{{ button.variant|default('primary') }}"

                    {% if button.action %}
                        name="action"
                        value="{{ button.action }}"
                    {% endif %}

                    {% if button.confirm_required %}
                        data-confirm="1"
                    {% endif %}
                >
                    {{ button.label_key }}
                </button>

            {% endfor %}

        </div>

    {% endif %}

</form>

</div>