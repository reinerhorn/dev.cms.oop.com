<footer class="{{ footer.css }}">

    <div class="footer-info">

        <p>
            <a href="{{ footer.link }}">
                {{ footer.headline }}
            </a>
        </p>

        {% if footer.version is not empty %}
            <small>{{ footer.version }}</small>
        {% endif %}

        {% if footer.images is not empty %}
            <div class="footer-images">
                {% for image in footer.images %}
                    <img
                        src="{{ image.image_url }}"
                        alt="{{ image.alt_text }}"
                    >
                {% endfor %}
            </div>
        {% endif %}

    </div>

</footer>