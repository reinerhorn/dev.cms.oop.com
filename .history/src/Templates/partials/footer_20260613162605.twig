<footer class="footer">
    <div class="footer-info">

        <p class="footer-copy">
            &copy; 2020 - 2025 {{ footer.company }}
        </p>

        {% if footer.version is not empty %}
            <p class="footer-version">{{ footer.version }}</p>
        {% endif %}

        {% if footer.images is not empty %}
            <div class="footer-images">

                {% for image in footer.images %}

                    {% if image.link_url is not empty %}
                        <a class="footer-image-link" href="{{ image.link_url }}">
                            <img
                                class="footer-image"
                                src="{{ image.image_url|trim }}"
                                alt="{{ image.alt_text }}"
                            >
                        </a>
                    {% else %}
                        <img
                            class="footer-image"
                            src="{{ image.image_url|trim }}"
                            alt="{{ image.alt_text }}"
                        >
                    {% endif %}

                {% endfor %}

            </div>
        {% endif %}

    </div>
</footer>