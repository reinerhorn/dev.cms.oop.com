<footer class="{{ footer.css }}">
    <div class="footer-info">

        <p>
            <a href="{{ footer.link }}">
                {{ footer.headline }}
            </a>
        </p>

        {% if footer.version is not empty %}
            <small>{{ footer.version }}</small>
        {% endif %}

        {% if footer.images is not empty %}
            <div class="footer-images">
                {% for image in footer.images %}

                    {% if image.link_url is not empty %}
                        <a href="{{ image.link_url }}">
                            <img
                                src="{{ image.image_url starts with '/' ? image.image_url : '/' ~ image.image_url }}"
                                alt="{{ image.alt_text }}"
                            >
                        </a>
                    {% else %}
                        <img
                            src="{{ image.image_url starts with '/' ? image.image_url : '/' ~ image.image_url }}"
                            alt="{{ image.alt_text }}"
                        >
                    {% endif %}

                {% endfor %}
            </div>
        {% endif %}

    </div>

</footer>