    }

    public function delete(string $id): bool
    {
        $stmt = $this->db->prepare(
            "DELETE FROM {{table}} WHERE {{primaryKey}} = ?"
        );

        $stmt->bind_param("s", $id);

        return $stmt->execute();
    }

    private function uuid(): string
    {
        return bin2hex(random_bytes(16));
    }
