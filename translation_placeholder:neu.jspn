 {
  "form_id": "navigation_editor",
  "entity": {
    "table": "navigation",
    "primary_key": "id"
  },
  "method": "POST",
  "fields": [
    {
      "name": "load_id",
      "db": { "type": "virtual" },
      "ui": {
        "type": "select",
        "id": "load_id",
        "class": "form-control",
        "auto_submit": true,
        "options_source": {
          "table": "navigation",
          "value_field": "id",
          "label_field": "id"
        }
      },
      "label": {
        "text": "Datensatz auswählen",
        "for": "load_id"
      }
    },

    {
      "name": "id",
      "db": {
        "type": "column",
        "required": true
      },
      "ui": {
        "type": "text",
        "id": "id",
        "class": "form-control",
        "placeholder": "Eindeutige ID (z.B. main_nav)"
      },
      "label": {
        "text": "ID",
        "for": "id"
      }
    }
  ]
}
