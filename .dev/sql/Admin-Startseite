-- Startseite → Gäste
INSERT INTO page_permissions (page_permission_id, fk_page_uuid, permission_id)
SELECT UUID(), '73a6be54-7bf6-11f0-be30-c26cf33f6ee6', 'perm-view-guest'
WHERE NOT EXISTS (
    SELECT 1 FROM page_permissions
    WHERE fk_page_uuid = '73a6be54-7bf6-11f0-be30-c26cf33f6ee6'
