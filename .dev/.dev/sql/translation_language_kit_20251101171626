-- ============================================
-- 🧩 CMS OOP: Collation-Fix für Übersetzungen
-- ============================================

-- 🔹 1. Bestehenden Fremdschlüssel löschen
ALTER TABLE translation 
DROP FOREIGN KEY fk_translation_language;

-- 🔹 2. Zeichensatz & Collation in trans_language korrigieren
ALTER TABLE trans_language 
MODIFY id VARCHAR(10) 
CHARACTER SET utf8mb4 
COLLATE utf8mb4_unicode_ci;

-- 🔹 3. Zeichensatz & Collation in translation korrigieren
ALTER TABLE translation 
MODIFY fk_language_id VARCHAR(10) 
CHARACTER SET utf8mb4 
COLLATE utf8mb4_unicode_ci;

-- 🔹 4. Fremdschlüssel wiederherstellen
ALTER TABLE translation 
ADD CONSTRAINT fk_translation_language
FOREIGN KEY (fk_language_id)
REFERENCES trans_language(id)
ON DELETE CASCADE
ON UPDATE CASCADE;

-- 🔹 5. Kontrolle (optional)
-- Überprüfen, ob beide Tabellen nun übereinstimmende Collation haben
SELECT 
    TABLE_NAME, 
    COLUMN_NAME, 
    CHARACTER_SET_NAME, 
    COLLATION_NAME
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'dbs_cms_oop'
  AND TABLE_NAME IN ('translation', 'trans_language')
  AND COLUMN_NAME IN ('fk_language_id', 'id');

-- ============================================
-- ✅ Ergebnis:
-- Beide Tabellen verwenden nun utf8mb4_unicode_ci
-- und sind wieder kompatibel für JOINS & Views.
-- ============================================